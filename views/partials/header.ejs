<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch - Exclusive Luxury Bags & Accessories</title>
    <!-- Remixicon -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .toast-animate {
            animation: slideDownFade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes slideDownFade {
            from {
                opacity: 0;
                transform: translate(-50%, -20px);
            }
            to {
                opacity: 1;
                transform: translate(-50%, 0);
            }
        }
    </style>
</head>

<body class="bg-zinc-50 font-sans text-zinc-900 min-h-screen flex flex-col antialiased selection:bg-zinc-900 selection:text-white">

    <!-- Toast Notifications -->
    <div id="toastContainer" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] w-11/12 max-w-md pointer-events-none">
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <div class="toast-item pointer-events-auto mb-2 p-4 rounded-xl bg-rose-600 text-white shadow-xl flex items-center justify-between gap-3 border border-rose-500 toast-animate">
                <div class="flex items-center gap-3">
                    <i class="ri-error-warning-fill text-xl shrink-0"></i>
                    <span class="text-sm font-medium"><%= error[0] %></span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-rose-200 hover:text-white transition">
                    <i class="ri-close-line text-lg"></i>
                </button>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <div class="toast-item pointer-events-auto mb-2 p-4 rounded-xl bg-emerald-600 text-white shadow-xl flex items-center justify-between gap-3 border border-emerald-500 toast-animate">
                <div class="flex items-center gap-3">
                    <i class="ri-checkbox-circle-fill text-xl shrink-0"></i>
                    <span class="text-sm font-medium"><%= success[0] %></span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-emerald-200 hover:text-white transition">
                    <i class="ri-close-line text-lg"></i>
                </button>
            </div>
        <% } %>
    </div>

    <!-- Header Navbar -->
    <header class="w-full fixed top-0 left-0 z-50 glass-nav border-b border-zinc-200/80 transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                
                <!-- Brand Logo -->
                <a href="<%= user ? '/shop' : '/' %>" class="flex items-center gap-2 group">
                    <div class="w-9 h-9 rounded-xl bg-zinc-900 text-white flex items-center justify-center font-display font-bold text-xl group-hover:bg-blue-600 transition-colors shadow-sm">
                        S
                    </div>
                    <span class="font-display font-bold text-2xl tracking-tight text-zinc-900">
                        scatch<span class="text-blue-600">.</span>
                    </span>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center gap-6">
                    <% if (user) { %>
                        <a href="/shop" class="text-sm font-medium text-zinc-700 hover:text-zinc-900 transition flex items-center gap-1.5 py-1 px-3 rounded-lg hover:bg-zinc-100">
                            <i class="ri-store-2-line text-base text-zinc-500"></i> Shop
                        </a>
                        <a href="/orders" class="text-sm font-medium text-zinc-700 hover:text-zinc-900 transition flex items-center gap-1.5 py-1 px-3 rounded-lg hover:bg-zinc-100">
                            <i class="ri-shopping-bag-3-line text-base text-zinc-500"></i> My Orders
                        </a>
                        <a href="/cart" class="text-sm font-medium text-zinc-700 hover:text-zinc-900 transition flex items-center gap-2 py-1 px-3 rounded-lg hover:bg-zinc-100 relative">
                            <i class="ri-shopping-cart-2-line text-base text-zinc-500"></i> Cart
                            <% if (user.cart && user.cart.length > 0) { %>
                                <span class="bg-blue-600 text-white text-[11px] font-bold px-2 py-0.5 rounded-full min-w-[20px] text-center">
                                    <%= user.cart.length %>
                                </span>
                            <% } %>
                        </a>
                        
                        <div class="h-4 w-[1px] bg-zinc-300 mx-1"></div>

                        <div class="flex items-center gap-3">
                            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-zinc-100 text-zinc-700 border border-zinc-200">
                                Hi, <%= user.fullname.split(' ')[0] %>
                            </span>
                            <a href="/users/logout" class="text-sm font-medium text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-3 py-1.5 rounded-lg transition">
                                Logout
                            </a>
                        </div>

                    <% } else if (owner) { %>
                        <a href="/owners/admin" class="text-sm font-medium text-zinc-700 hover:text-zinc-900 transition flex items-center gap-1.5 py-1 px-3 rounded-lg hover:bg-zinc-100">
                            <i class="ri-dashboard-line text-base text-blue-600"></i> Admin Panel
                        </a>
                        <a href="/products/create" class="text-sm font-medium text-zinc-700 hover:text-zinc-900 transition flex items-center gap-1.5 py-1 px-3 rounded-lg hover:bg-zinc-100">
                            <i class="ri-add-circle-line text-base text-zinc-500"></i> Create Product
                        </a>
                        
                        <div class="h-4 w-[1px] bg-zinc-300 mx-1"></div>

                        <div class="flex items-center gap-3">
                            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-300">
                                Admin Mode
                            </span>
                            <a href="/owners/logout" class="text-sm font-medium text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-3 py-1.5 rounded-lg transition">
                                Exit Admin
                            </a>
                        </div>

                    <% } else { %>
                        <a href="/" class="text-sm font-medium text-zinc-700 hover:text-zinc-900 transition">
                            Customer Login
                        </a>
                        <a href="/owners/login" class="text-sm font-medium px-4 py-2 rounded-full bg-zinc-900 text-white hover:bg-zinc-800 transition shadow-sm">
                            Admin Portal
                        </a>
                    <% } %>
                </nav>

                <!-- Mobile Hamburger Button -->
                <button id="mobileMenuBtn" class="md:hidden p-2 rounded-lg text-zinc-700 hover:bg-zinc-100 focus:outline-none">
                    <i class="ri-menu-4-line text-2xl"></i>
                </button>

            </div>
        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobileMenu" class="hidden md:hidden border-t border-zinc-200 bg-white/95 px-4 pt-3 pb-6 space-y-3 shadow-lg">
            <% if (user) { %>
                <div class="pb-2 mb-2 border-b border-zinc-100 flex items-center justify-between">
                    <span class="text-xs font-semibold text-zinc-500">Logged in as <%= user.fullname %></span>
                    <span class="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full font-medium">User</span>
                </div>
                <a href="/shop" class="flex items-center gap-2 px-3 py-2 rounded-lg text-zinc-800 hover:bg-zinc-100 text-sm font-medium">
                    <i class="ri-store-2-line text-blue-600"></i> Shop
                </a>
                <a href="/orders" class="flex items-center gap-2 px-3 py-2 rounded-lg text-zinc-800 hover:bg-zinc-100 text-sm font-medium">
                    <i class="ri-shopping-bag-3-line text-blue-600"></i> My Orders
                </a>
                <a href="/cart" class="flex items-center justify-between px-3 py-2 rounded-lg text-zinc-800 hover:bg-zinc-100 text-sm font-medium">
                    <div class="flex items-center gap-2">
                        <i class="ri-shopping-cart-2-line text-blue-600"></i> My Cart
                    </div>
                    <% if (user.cart && user.cart.length > 0) { %>
                        <span class="bg-blue-600 text-white text-xs font-bold px-2 py-0.5 rounded-full">
                            <%= user.cart.length %>
                        </span>
                    <% } %>
                </a>
                <a href="/users/logout" class="flex items-center gap-2 px-3 py-2 rounded-lg text-rose-600 hover:bg-rose-50 text-sm font-medium mt-2">
                    <i class="ri-logout-box-r-line"></i> Logout
                </a>
            <% } else if (owner) { %>
                <a href="/owners/admin" class="flex items-center gap-2 px-3 py-2 rounded-lg text-zinc-800 hover:bg-zinc-100 text-sm font-medium">
                    <i class="ri-dashboard-line text-blue-600"></i> Admin Panel
                </a>
                <a href="/products/create" class="flex items-center gap-2 px-3 py-2 rounded-lg text-zinc-800 hover:bg-zinc-100 text-sm font-medium">
                    <i class="ri-add-circle-line text-blue-600"></i> Create Product
                </a>
                <a href="/owners/logout" class="flex items-center gap-2 px-3 py-2 rounded-lg text-rose-600 hover:bg-rose-50 text-sm font-medium">
                    <i class="ri-logout-box-r-line"></i> Exit Admin
                </a>
            <% } else { %>
                <a href="/" class="block px-3 py-2 rounded-lg text-zinc-800 hover:bg-zinc-100 text-sm font-medium">
                    Customer Login / Register
                </a>
                <a href="/owners/login" class="block px-3 py-2 rounded-lg bg-zinc-900 text-white text-center text-sm font-medium">
                    Admin Portal
                </a>
            <% } %>
        </div>
    </header>

    <script>
        // Auto dismiss toast messages after 4 seconds
        setTimeout(() => {
            document.querySelectorAll('.toast-item').forEach(toast => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, -20px)';
                toast.style.transition = 'all 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            });
        }, 4000);

        // Mobile menu toggle
        const mobileBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        if (mobileBtn && mobileMenu) {
            mobileBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>
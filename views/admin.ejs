<%- include('./partials/header') %>

<main class="w-full min-h-screen pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">

    <!-- Dashboard Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-zinc-200">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-300 text-xs font-bold mb-2">
                <i class="ri-admin-line"></i> Store Management
            </div>
            <h1 class="text-3xl font-bold font-display text-zinc-900 tracking-tight">Admin Dashboard</h1>
            <p class="text-sm text-zinc-500 mt-1">Manage catalog inventory, add new products, and remove items</p>
        </div>

        <div class="flex items-center gap-3">
            <a
                href="/products/create"
                class="px-5 py-2.5 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition shadow-lg shadow-blue-500/20 flex items-center gap-2"
            >
                <i class="ri-add-line text-lg"></i> Create Product
            </a>
            <% if (products && products.length > 0) { %>
                <a
                    onclick="return confirm('Are you sure you want to delete all products? This action cannot be undone.')"
                    href="/products/deleteall"
                    class="px-4 py-2.5 rounded-2xl bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold text-sm transition border border-rose-200 flex items-center gap-1.5"
                >
                    <i class="ri-delete-bin-line"></i> Delete All
                </a>
            <% } %>
        </div>
    </div>

    <!-- Main Admin Layout -->
    <div class="flex flex-col lg:flex-row gap-8 items-start">

        <!-- Sidebar Controls -->
        <aside class="w-full lg:w-64 bg-white rounded-2xl p-6 border border-zinc-200/90 shadow-sm shrink-0">
            <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-4">
                Management Menu
            </h3>
            
            <div class="space-y-1">
                <a
                    href="/owners/admin"
                    class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-zinc-900 text-white font-semibold text-sm transition"
                >
                    <div class="flex items-center gap-2">
                        <i class="ri-grid-fill"></i> All Inventory
                    </div>
                    <span class="bg-zinc-800 text-zinc-300 text-xs px-2 py-0.5 rounded-full font-bold">
                        <%= products ? products.length : 0 %>
                    </span>
                </a>

                <a
                    href="/products/create"
                    class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 font-medium text-sm transition"
                >
                    <i class="ri-add-circle-line text-blue-600"></i> Add New Product
                </a>
            </div>

            <div class="mt-8 pt-6 border-t border-zinc-100">
                <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/60 text-xs text-zinc-600 space-y-2">
                    <div class="font-bold text-zinc-800 flex items-center gap-1.5">
                        <i class="ri-information-line text-blue-600"></i> Catalog Overview
                    </div>
                    <p>Total Products: <span class="font-bold text-zinc-900"><%= products ? products.length : 0 %></span></p>
                </div>
            </div>
        </aside>

        <!-- Product Grid -->
        <section class="flex-grow w-full">

            <% if (!products || products.length === 0) { %>
                <div class="bg-white rounded-3xl p-12 text-center border border-zinc-200 shadow-sm">
                    <div class="w-16 h-16 bg-zinc-100 text-zinc-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                        <i class="ri-box-3-line"></i>
                    </div>
                    <h3 class="text-xl font-bold text-zinc-800 mb-2">No Products in Catalog</h3>
                    <p class="text-zinc-500 text-sm max-w-md mx-auto mb-6">Start building your luxury store catalog by adding your first product.</p>
                    <a href="/products/create" class="inline-block px-6 py-3 rounded-full bg-blue-600 text-white font-semibold text-sm hover:bg-blue-700 transition">
                        Create First Product
                    </a>
                </div>
            <% } else { %>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                    <% products.forEach(function(product){ %>

                        <div class="bg-white rounded-3xl overflow-hidden border border-zinc-200/90 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
                            
                            <!-- Image Container -->
                            <div
                                class="relative w-full h-56 flex items-center justify-center p-4 overflow-hidden"
                                style="background-color: <%= product.bgcolor || '#f3f4f6' %>;"
                            >
                                <% if (product.discount && product.discount > 0) { %>
                                    <span class="absolute top-3 left-3 z-10 text-xs font-bold bg-rose-600 text-white px-2.5 py-1 rounded-full shadow">
                                        ₹<%= product.discount %> OFF
                                    </span>
                                <% } %>

                                <% if (product.image) { %>
                                    <img
                                        class="w-full h-full object-contain drop-shadow"
                                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                        alt="<%= product.name %>"
                                    >
                                <% } else { %>
                                    <i class="ri-handbag-line text-zinc-400 text-5xl"></i>
                                <% } %>
                            </div>

                            <!-- Detail & Action Bar -->
                            <div
                                class="p-4 flex items-center justify-between transition-colors"
                                style="background-color: <%= product.panelcolor || '#ffffff' %>; color: <%= product.textcolor || '#18181b' %>;"
                            >
                                <div>
                                    <h3 class="font-display font-bold text-base line-clamp-1">
                                        <%= product.name %>
                                    </h3>
                                    <div class="flex items-center gap-2 mt-0.5">
                                        <span class="font-bold text-sm">
                                            ₹ <%= Math.max(0, product.price - (product.discount || 0)) %>
                                        </span>
                                        <% if (product.discount && product.discount > 0) { %>
                                            <span class="text-xs opacity-60 line-through">
                                                ₹ <%= product.price %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <a
                                    title="Delete product"
                                    onclick="return confirm('Are you sure you want to delete this product?')"
                                    class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/90 text-rose-600 hover:bg-rose-600 hover:text-white transition shadow-sm border border-zinc-200/50 shrink-0"
                                    href="/products/delete/<%= product._id %>"
                                >
                                    <i class="ri-delete-bin-line text-lg"></i>
                                </a>
                            </div>

                        </div>

                    <% }); %>

                </div>

            <% } %>

        </section>

    </div>

</main>

<%- include('./partials/footer') %>
<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-zinc-50 pt-28 pb-16 px-4 md:px-12 lg:px-20">
    <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-zinc-200">
            <div>
                <h1 class="text-3xl font-bold text-zinc-900 tracking-tight">My Order History</h1>
                <p class="text-sm text-zinc-500 mt-1">Review your luxury collection purchases</p>
            </div>
            <a href="/shop" class="px-5 py-2.5 rounded-full bg-zinc-900 text-white text-sm font-medium hover:bg-zinc-800 transition flex items-center gap-2">
                <i class="ri-shopping-bag-line"></i> Continue Shopping
            </a>
        </div>

        <% if (!orders || orders.length === 0) { %>
            <div class="bg-white rounded-2xl p-12 text-center border border-zinc-200 shadow-sm my-12">
                <div class="w-20 h-20 bg-zinc-100 text-zinc-400 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
                    <i class="ri-inbox-archive-line"></i>
                </div>
                <h3 class="text-xl font-bold text-zinc-800 mb-2">No Orders Yet</h3>
                <p class="text-zinc-500 max-w-md mx-auto mb-6 text-sm">You haven't placed any luxury bag orders with us yet. Start exploring our exclusive collection today.</p>
                <a href="/shop" class="inline-block px-6 py-3 rounded-full bg-blue-600 text-white font-medium text-sm hover:bg-blue-700 transition">
                    Explore Shop
                </a>
            </div>
        <% } else { %>
            <div class="space-y-6">
                <% orders.forEach(function(order, index) { %>
                    <div class="bg-white rounded-2xl p-6 border border-zinc-200 shadow-sm hover:shadow-md transition">
                        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 mb-4 border-b border-zinc-100">
                            <div>
                                <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
                                    Order #<%= orders.length - index %>
                                </span>
                                <span class="text-xs text-zinc-400 ml-3">
                                    <%= new Date(order.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                </span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-medium bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full flex items-center gap-1">
                                    <i class="ri-checkbox-circle-fill"></i> Confirmed & Processing
                                </span>
                                <span class="text-lg font-bold text-zinc-900">
                                    ₹ <%= order.totalAmount %>
                                </span>
                            </div>
                        </div>

                        <!-- Order items -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            <% order.items.forEach(function(item) { %>
                                <% if (item) { %>
                                    <div class="flex items-center gap-4 p-3 rounded-xl bg-zinc-50 border border-zinc-100">
                                        <div class="w-16 h-16 rounded-lg overflow-hidden flex items-center justify-center shrink-0" style="background-color: <%= item.bgcolor || '#f1f5f9' %>;">
                                            <% if (item.image) { %>
                                                <img class="w-full h-full object-contain p-1" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="<%= item.name %>">
                                            <% } else { %>
                                                <i class="ri-handbag-line text-zinc-400 text-xl"></i>
                                            <% } %>
                                        </div>
                                        <div>
                                            <h4 class="font-semibold text-zinc-800 text-sm line-clamp-1"><%= item.name %></h4>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="text-sm font-bold text-zinc-900">₹ <%= item.price - (item.discount || 0) %></span>
                                                <% if (item.discount > 0) { %>
                                                    <span class="text-xs text-zinc-400 line-through">₹ <%= item.price %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            <% }); %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('./partials/footer') %>

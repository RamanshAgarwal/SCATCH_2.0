<%- include('./partials/header') %>

<main class="w-full min-h-screen pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">

    <div class="flex items-center justify-between mb-8 pb-4 border-b border-zinc-200">
        <div>
            <h1 class="text-3xl font-bold font-display text-zinc-900 tracking-tight">Shopping Cart</h1>
            <p class="text-sm text-zinc-500 mt-1">Review your luxury selections before checkout</p>
        </div>
        <% if (cartItems && cartItems.length > 0) { %>
            <a href="/cart/clear" class="text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-full transition">
                <i class="ri-delete-bin-line"></i> Clear Cart
            </a>
        <% } %>
    </div>

    <% if (!cartItems || cartItems.length === 0) { %>
        <div class="bg-white rounded-3xl p-12 text-center border border-zinc-200/90 shadow-sm my-8">
            <div class="w-20 h-20 bg-zinc-100 text-zinc-400 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
                <i class="ri-shopping-cart-line"></i>
            </div>
            <h3 class="text-xl font-bold text-zinc-800 mb-2">Your Cart is Empty</h3>
            <p class="text-zinc-500 text-sm max-w-md mx-auto mb-6">Explore our handcrafted luxury bag collection and add your favorite items to your cart.</p>
            <a href="/shop" class="inline-block px-6 py-3 rounded-full bg-blue-600 text-white font-semibold text-sm hover:bg-blue-700 transition shadow-lg shadow-blue-500/20">
                Explore Collection
            </a>
        </div>
    <% } else { %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- Cart Items List (8 cols) -->
            <div class="lg:col-span-8 space-y-4">
                <% cartItems.forEach(function(item, index) { %>
                    <% if (item) { %>
                        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-zinc-200/90 shadow-sm hover:shadow-md transition flex flex-col sm:flex-row items-center justify-between gap-4">
                            
                            <!-- Thumbnail & Product Info -->
                            <div class="flex items-center gap-4 w-full sm:w-auto">
                                <div
                                    class="w-20 h-20 rounded-xl overflow-hidden flex items-center justify-center shrink-0 border border-zinc-200/60 p-2"
                                    style="background-color: <%= item.bgcolor || '#f3f4f6' %>;"
                                >
                                    <% if (item.image) { %>
                                        <img class="w-full h-full object-contain" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="<%= item.name %>">
                                    <% } else { %>
                                        <i class="ri-handbag-line text-zinc-400 text-2xl"></i>
                                    <% } %>
                                </div>

                                <div>
                                    <h3 class="font-display font-bold text-zinc-900 text-base leading-snug">
                                        <%= item.name %>
                                    </h3>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-xs px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-600 border border-zinc-200 font-medium">
                                            Luxury Leather
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Pricing & Actions -->
                            <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto pt-3 sm:pt-0 border-t sm:border-t-0 border-zinc-100">
                                <div class="text-right">
                                    <div class="text-lg font-bold text-zinc-900">
                                        ₹ <%= Math.max(0, item.price - (item.discount || 0)) %>
                                    </div>
                                    <% if (item.discount && item.discount > 0) { %>
                                        <div class="text-xs text-rose-500 font-medium line-through">
                                            ₹ <%= item.price %>
                                        </div>
                                    <% } %>
                                </div>

                                <a
                                    title="Remove item"
                                    href="/cart/remove/<%= item._id %>"
                                    class="w-9 h-9 rounded-xl bg-zinc-100 text-zinc-500 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition"
                                >
                                    <i class="ri-delete-bin-line text-lg"></i>
                                </a>
                            </div>

                        </div>
                    <% } %>
                <% }); %>
            </div>

            <!-- Order Summary / Bill (4 cols) -->
            <div class="lg:col-span-4 bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200/90 shadow-sm sticky top-24">
                <h3 class="font-display font-bold text-xl text-zinc-900 mb-6 pb-3 border-b border-zinc-100">
                    Order Summary
                </h3>

                <div class="space-y-3 text-sm mb-6">
                    <div class="flex items-center justify-between text-zinc-600">
                        <span>Total Price (MRP)</span>
                        <span class="font-semibold text-zinc-900">₹ <%= bill.totalMRP %></span>
                    </div>

                    <div class="flex items-center justify-between text-zinc-600">
                        <span>Discount on MRP</span>
                        <span class="font-semibold text-emerald-600">- ₹ <%= bill.totalDiscount %></span>
                    </div>

                    <div class="flex items-center justify-between text-zinc-600">
                        <span>Platform Handling Fee</span>
                        <span class="font-semibold text-zinc-900">₹ <%= bill.platformFee %></span>
                    </div>

                    <div class="flex items-center justify-between text-zinc-600">
                        <span>Express Shipping</span>
                        <span class="font-semibold text-emerald-600 uppercase">
                            <%= bill.shippingFee === 0 ? 'FREE' : '₹ ' + bill.shippingFee %>
                        </span>
                    </div>
                </div>

                <div class="pt-4 mb-6 border-t border-zinc-200 flex items-center justify-between">
                    <div>
                        <span class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Total Payable</span>
                        <span class="text-2xl font-bold font-display text-emerald-600">₹ <%= bill.totalAmount %></span>
                    </div>
                </div>

                <form action="/cart/checkout" method="post">
                    <button
                        type="submit"
                        class="w-full py-3.5 px-6 rounded-2xl bg-zinc-900 hover:bg-zinc-800 text-white font-bold text-sm transition shadow-xl active:scale-[0.99] flex items-center justify-center gap-2"
                    >
                        <i class="ri-shield-check-line text-lg"></i>
                        <span>Proceed to Checkout</span>
                    </button>
                </form>

                <div class="mt-4 flex items-center justify-center gap-2 text-xs text-zinc-400">
                    <i class="ri-lock-line"></i> Encrypted 256-bit Secure Checkout
                </div>
            </div>

        </div>

    <% } %>

</main>

<%- include('./partials/footer') %>
<%- include('./partials/header') %>

<main class="w-full min-h-screen pt-24 pb-16 px-4 sm:px-6 lg:px-8 flex items-center justify-center relative overflow-hidden bg-gradient-to-br from-zinc-900 via-zinc-950 to-black text-white">

    <!-- Ambient glowing accents -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md mx-auto relative z-10">

        <div class="bg-zinc-900/90 backdrop-blur-2xl rounded-3xl p-8 sm:p-10 border border-zinc-800 shadow-2xl shadow-black/80">
            
            <div class="text-center mb-8">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-display font-bold text-2xl mx-auto mb-4 shadow-lg shadow-blue-500/25">
                    <i class="ri-shield-user-line"></i>
                </div>
                
                <% if (typeof ownerExists !== 'undefined' && !ownerExists) { %>
                    <h2 class="text-2xl sm:text-3xl font-display font-bold tracking-tight">
                        Initial Admin Setup
                    </h2>
                    <p class="text-xs text-zinc-400 mt-2">
                        No owner account detected. Register as the primary administrator of Scatch.
                    </p>
                <% } else { %>
                    <h2 class="text-2xl sm:text-3xl font-display font-bold tracking-tight">
                        Admin Portal
                    </h2>
                    <p class="text-xs text-zinc-400 mt-2">
                        Sign in with your store owner credentials to access inventory controls.
                    </p>
                <% } %>
            </div>

            <% if (typeof ownerExists !== 'undefined' && !ownerExists) { %>
                <!-- Create Owner Form -->
                <form autocomplete="off" action="/owners/create" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Full Name</label>
                        <input
                            class="bg-zinc-800/90 focus:bg-zinc-800 w-full px-4 py-3 border border-zinc-700 focus:border-blue-500 rounded-xl outline-none text-sm text-white transition font-medium"
                            type="text"
                            placeholder="Store Manager Name"
                            name="fullname"
                            required
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Admin Email</label>
                        <input
                            class="bg-zinc-800/90 focus:bg-zinc-800 w-full px-4 py-3 border border-zinc-700 focus:border-blue-500 rounded-xl outline-none text-sm text-white transition font-medium"
                            type="email"
                            placeholder="admin@scatch.com"
                            name="email"
                            required
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Master Password</label>
                        <input
                            class="bg-zinc-800/90 focus:bg-zinc-800 w-full px-4 py-3 border border-zinc-700 focus:border-blue-500 rounded-xl outline-none text-sm text-white transition font-medium"
                            type="password"
                            placeholder="••••••••"
                            name="password"
                            required
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">GSTIN Number (Optional)</label>
                        <input
                            class="bg-zinc-800/90 focus:bg-zinc-800 w-full px-4 py-3 border border-zinc-700 focus:border-blue-500 rounded-xl outline-none text-sm text-white transition font-medium"
                            type="text"
                            placeholder="GSTIN12345678"
                            name="gstin"
                        >
                    </div>

                    <button
                        type="submit"
                        class="w-full mt-4 py-3.5 px-6 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition shadow-lg shadow-blue-600/30 flex items-center justify-center gap-2"
                    >
                        <span>Create Owner Account</span>
                        <i class="ri-arrow-right-line"></i>
                    </button>
                </form>
            <% } else { %>
                <!-- Login Owner Form -->
                <form autocomplete="off" action="/owners/login" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Owner Email</label>
                        <input
                            class="bg-zinc-800/90 focus:bg-zinc-800 w-full px-4 py-3 border border-zinc-700 focus:border-blue-500 rounded-xl outline-none text-sm text-white transition font-medium"
                            type="email"
                            placeholder="admin@scatch.com"
                            name="email"
                            required
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Password</label>
                        <input
                            class="bg-zinc-800/90 focus:bg-zinc-800 w-full px-4 py-3 border border-zinc-700 focus:border-blue-500 rounded-xl outline-none text-sm text-white transition font-medium"
                            type="password"
                            placeholder="••••••••"
                            name="password"
                            required
                        >
                    </div>

                    <button
                        type="submit"
                        class="w-full mt-4 py-3.5 px-6 rounded-xl bg-white hover:bg-zinc-100 text-zinc-950 font-bold text-sm transition shadow-lg flex items-center justify-center gap-2"
                    >
                        <span>Login as Admin</span>
                        <i class="ri-login-circle-line"></i>
                    </button>
                </form>
            <% } %>

            <div class="mt-6 pt-4 border-t border-zinc-800 text-center">
                <a href="/" class="text-xs text-zinc-400 hover:text-white transition">
                    &larr; Back to Customer Store
                </a>
            </div>

        </div>

    </div>

</main>

<%- include('./partials/footer') %>
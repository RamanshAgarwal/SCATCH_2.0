<%- include('./partials/header') %>

<main class="w-full min-h-screen pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">

    <!-- Hero Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-zinc-900 text-white mb-10 p-8 sm:p-12 border border-zinc-800 shadow-xl">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-2xl">
            <span class="text-xs font-bold uppercase tracking-widest text-blue-400 bg-blue-500/10 px-3 py-1 rounded-full border border-blue-500/20 inline-block mb-3">
                Summer 2026 Collection
            </span>
            <h1 class="text-3xl sm:text-5xl font-display font-bold tracking-tight mb-4 text-white">
                Crafted for Distinction.
            </h1>
            <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
                Explore our curated ensemble of luxury leather totes, backpacks, and designer travel companions built with uncompromising precision.
            </p>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="flex flex-col lg:flex-row gap-8 items-start">

        <!-- Sidebar Filters -->
        <aside class="w-full lg:w-64 bg-white rounded-2xl p-6 border border-zinc-200/80 shadow-sm shrink-0">
            
            <!-- Sort By Header & Form -->
            <div class="mb-6 pb-6 border-b border-zinc-100">
                <label class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">
                    Sort Collection
                </label>
                <form action="/shop" method="get" id="sortForm">
                    <% if (typeof filter !== 'undefined' && filter) { %>
                        <input type="hidden" name="filter" value="<%= filter %>">
                    <% } %>
                    <select
                        name="sortby"
                        onchange="document.getElementById('sortForm').submit()"
                        class="w-full bg-zinc-50 border border-zinc-200 text-zinc-800 text-sm font-semibold rounded-xl px-3 py-2.5 outline-none focus:border-blue-600 focus:bg-white transition cursor-pointer"
                    >
                        <option value="newest" <%= (typeof sortby !== 'undefined' && sortby === 'newest') ? 'selected' : '' %>>Newest Arrivals</option>
                        <option value="price_asc" <%= (typeof sortby !== 'undefined' && sortby === 'price_asc') ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price_desc" <%= (typeof sortby !== 'undefined' && sortby === 'price_desc') ? 'selected' : '' %>>Price: High to Low</option>
                        <option value="discount" <%= (typeof sortby !== 'undefined' && sortby === 'discount') ? 'selected' : '' %>>Highest Discount</option>
                    </select>
                </form>
            </div>

            <!-- Categories / Quick Filter Navigation -->
            <div class="space-y-6">
                <div>
                    <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-3">
                        Categories
                    </h3>
                    <div class="space-y-1">
                        <a
                            href="/shop?filter=all"
                            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-medium transition <%= (typeof filter === 'undefined' || filter === 'all') ? 'bg-zinc-900 text-white font-semibold' : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900' %>"
                        >
                            <span>All Products</span>
                            <i class="ri-arrow-right-s-line"></i>
                        </a>
                        <a
                            href="/shop?filter=discount"
                            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-medium transition <%= (typeof filter !== 'undefined' && filter === 'discount') ? 'bg-zinc-900 text-white font-semibold' : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900' %>"
                        >
                            <span>Special Offers</span>
                            <span class="text-xs bg-rose-500 text-white font-bold px-2 py-0.5 rounded-full">Sale</span>
                        </a>
                    </div>
                </div>

                <!-- Guarantee Badge -->
                <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-100 text-blue-900 text-xs">
                    <div class="flex items-center gap-2 font-bold mb-1">
                        <i class="ri-shield-check-fill text-blue-600 text-base"></i> 100% Authentic
                    </div>
                    <p class="text-blue-700/80 leading-relaxed">
                        Every Scatch bag includes a certified authenticity certificate and 2-year warranty.
                    </p>
                </div>
            </div>

        </aside>

        <!-- Product Grid Container -->
        <section class="flex-grow w-full">

            <%
                let fallbackImages = [
                    "/designs/1bag.png",
                    "/designs/2bag.png",
                    "/designs/3bag 1.png",
                    "/designs/4bag.png",
                    "/designs/5bag.png",
                    "/designs/6bag.png",
                    "/designs/7bag.png",
                    "/designs/image 80.png",
                    "/designs/8bag.png",
                    "/designs/9bag.png",
                    "/designs/10bag.png"
                ];
            %>


            <% if (!products || products.length === 0) { %>
                <div class="bg-white rounded-3xl p-12 text-center border border-zinc-200 shadow-sm my-4">
                    <div class="w-16 h-16 bg-zinc-100 text-zinc-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                        <i class="ri-handbag-line"></i>
                    </div>
                    <h3 class="text-xl font-bold text-zinc-800 mb-2">No Products Found</h3>
                    <p class="text-zinc-500 text-sm max-w-md mx-auto mb-6">There are currently no products matching your selected filter.</p>
                    <a href="/shop" class="inline-block px-5 py-2.5 rounded-full bg-zinc-900 text-white font-medium text-sm hover:bg-zinc-800 transition">
                        Reset Filters
                    </a>
                </div>
            <% } else { %>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                    <% products.forEach(function(product, index){ %>

                        <div class="group bg-white rounded-3xl overflow-hidden border border-zinc-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">

                            <!-- Product Image Header Container -->
                            <div
                                class="relative w-full h-64 flex items-center justify-center p-6 overflow-hidden transition-colors"
                                style="background-color: <%= product.bgcolor || '#f3f4f6' %>;"
                            >

                                <!-- Discount Tag -->
                                <% if (product.discount && product.discount > 0) { %>
                                    <span class="absolute top-4 left-4 z-10 text-xs font-bold bg-rose-600 text-white px-3 py-1 rounded-full shadow-md">
                                        ₹<%= product.discount %> OFF
                                    </span>
                                <% } %>

                                <!-- Image -->
                                <% if (product.image) { %>
                                    <img
                                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-md"
                                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                        alt="<%= product.name %>"
                                    >
                                <% } else { %>
                                    <img
                                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-md"
                                        src="<%= fallbackImages[index % fallbackImages.length] %>"
                                        alt="<%= product.name %>"
                                    >
                                <% } %>

                            </div>

                            <!-- Product Details & Action Panel -->
                            <div
                                class="p-5 flex items-center justify-between transition-colors"
                                style="background-color: <%= product.panelcolor || '#ffffff' %>; color: <%= product.textcolor || '#18181b' %>;"
                            >

                                <div>
                                    <h3 class="font-display font-bold text-base leading-snug line-clamp-1">
                                        <%= product.name %>
                                    </h3>

                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="font-bold text-lg">
                                            ₹ <%= Math.max(0, product.price - (product.discount || 0)) %>
                                        </span>
                                        <% if (product.discount && product.discount > 0) { %>
                                            <span class="text-xs opacity-60 line-through">
                                                ₹ <%= product.price %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Add to Cart Button -->
                                <a
                                    title="Add to Cart"
                                    class="w-11 h-11 flex items-center justify-center rounded-2xl bg-white/90 text-zinc-900 shadow-md hover:scale-110 hover:bg-blue-600 hover:text-white transition-all duration-200 shrink-0 border border-zinc-200/50"
                                    href="/addtocart/<%= product._id %>"
                                >
                                    <i class="ri-add-line text-xl"></i>
                                </a>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </section>

    </div>

</main>

<%- include('./partials/footer') %>
<%- include('./partials/header') %>

<main class="w-full min-h-screen pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8 pb-6 border-b border-zinc-200">
        <div>
            <h1 class="text-3xl font-bold font-display text-zinc-900 tracking-tight">Create New Product</h1>
            <p class="text-sm text-zinc-500 mt-1">Add a new luxury product entry to the store catalog</p>
        </div>
        <a
            href="/owners/admin"
            class="px-4 py-2 rounded-xl bg-zinc-100 text-zinc-700 hover:bg-zinc-200 font-semibold text-sm transition flex items-center gap-1.5"
        >
            <i class="ri-arrow-left-line"></i> Back to Inventory
        </a>
    </div>

    <!-- Content Layout -->
    <div class="flex flex-col lg:flex-row gap-8 items-start">

        <!-- Sidebar Navigation -->
        <aside class="w-full lg:w-64 bg-white rounded-2xl p-6 border border-zinc-200/90 shadow-sm shrink-0">
            <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-4">
                Catalog Actions
            </h3>
            
            <div class="space-y-1">
                <a
                    href="/owners/admin"
                    class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 font-medium text-sm transition"
                >
                    <i class="ri-grid-line"></i> All Inventory
                </a>

                <a
                    href="/products/create"
                    class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-zinc-900 text-white font-semibold text-sm transition"
                >
                    <i class="ri-add-circle-fill text-blue-400"></i> Create New Product
                </a>
            </div>
        </aside>

        <!-- Product Form -->
        <section class="flex-grow w-full bg-white rounded-3xl p-6 sm:p-10 border border-zinc-200/90 shadow-sm">

            <form
                autocomplete="off"
                action="/products/create"
                method="post"
                enctype="multipart/form-data"
                class="space-y-8"
            >

                <!-- Section 1: Product Details -->
                <div>
                    <div class="flex items-center gap-2 pb-3 mb-6 border-b border-zinc-100">
                        <i class="ri-handbag-line text-blue-600 text-xl"></i>
                        <h2 class="text-lg font-bold text-zinc-900 font-display">
                            Basic Details & Media
                        </h2>
                    </div>

                    <!-- File Upload Input -->
                    <div class="mb-6">
                        <label class="block text-xs font-bold text-zinc-700 uppercase tracking-wider mb-2">
                            Product Image <span class="text-rose-500">*</span>
                        </label>
                        <div class="border-2 border-dashed border-zinc-200 hover:border-blue-500 rounded-2xl p-6 text-center bg-zinc-50/50 hover:bg-blue-50/30 transition cursor-pointer relative group">
                            <input
                                name="image"
                                type="file"
                                accept="image/*"
                                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                                required
                                onchange="previewImageFileName(this)"
                            >
                            <div class="flex flex-col items-center justify-center">
                                <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center mb-3 group-hover:scale-110 transition">
                                    <i class="ri-upload-cloud-2-line text-2xl"></i>
                                </div>
                                <span id="fileNameDisplay" class="text-sm font-semibold text-zinc-700">Click to upload product image</span>
                                <span class="text-xs text-zinc-400 mt-1">PNG, JPG, or WEBP up to 5MB</span>
                            </div>
                        </div>
                    </div>

                    <!-- Name, Price, Discount Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">
                                Product Name <span class="text-rose-500">*</span>
                            </label>
                            <input
                                name="name"
                                type="text"
                                placeholder="e.g. Scatch Noir Tote"
                                class="w-full bg-zinc-50 focus:bg-white px-4 py-3 border border-zinc-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 rounded-xl outline-none text-sm font-medium transition"
                                required
                            >
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">
                                Price (₹) <span class="text-rose-500">*</span>
                            </label>
                            <input
                                name="price"
                                type="number"
                                min="0"
                                placeholder="e.g. 2400"
                                class="w-full bg-zinc-50 focus:bg-white px-4 py-3 border border-zinc-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 rounded-xl outline-none text-sm font-medium transition"
                                required
                            >
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">
                                Discount Amount (₹)
                            </label>
                            <input
                                name="discount"
                                type="number"
                                min="0"
                                placeholder="e.g. 400"
                                class="w-full bg-zinc-50 focus:bg-white px-4 py-3 border border-zinc-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 rounded-xl outline-none text-sm font-medium transition"
                            >
                        </div>
                    </div>
                </div>

                <!-- Section 2: Custom Card Colors -->
                <div>
                    <div class="flex items-center gap-2 pb-3 mb-6 border-b border-zinc-100">
                        <i class="ri-palette-line text-blue-600 text-xl"></i>
                        <h2 class="text-lg font-bold text-zinc-900 font-display">
                            Custom Card Styling & Accent Colors
                        </h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <!-- Bg Color -->
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">
                                Image Background Color
                            </label>
                            <div class="flex items-center gap-2">
                                <input
                                    type="color"
                                    value="#e2e8f0"
                                    onchange="document.getElementById('bgcolorHex').value = this.value"
                                    class="w-10 h-10 rounded-xl border border-zinc-200 cursor-pointer shrink-0"
                                >
                                <input
                                    id="bgcolorHex"
                                    name="bgcolor"
                                    type="text"
                                    value="#e2e8f0"
                                    placeholder="#e2e8f0"
                                    class="w-full bg-zinc-50 px-3 py-2.5 border border-zinc-200 rounded-xl outline-none text-sm font-mono"
                                >
                            </div>
                        </div>

                        <!-- Panel Color -->
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">
                                Detail Panel Color
                            </label>
                            <div class="flex items-center gap-2">
                                <input
                                    type="color"
                                    value="#1e293b"
                                    onchange="document.getElementById('panelcolorHex').value = this.value"
                                    class="w-10 h-10 rounded-xl border border-zinc-200 cursor-pointer shrink-0"
                                >
                                <input
                                    id="panelcolorHex"
                                    name="panelcolor"
                                    type="text"
                                    value="#1e293b"
                                    placeholder="#1e293b"
                                    class="w-full bg-zinc-50 px-3 py-2.5 border border-zinc-200 rounded-xl outline-none text-sm font-mono"
                                >
                            </div>
                        </div>

                        <!-- Text Color -->
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">
                                Panel Text Color
                            </label>
                            <div class="flex items-center gap-2">
                                <input
                                    type="color"
                                    value="#ffffff"
                                    onchange="document.getElementById('textcolorHex').value = this.value"
                                    class="w-10 h-10 rounded-xl border border-zinc-200 cursor-pointer shrink-0"
                                >
                                <input
                                    id="textcolorHex"
                                    name="textcolor"
                                    type="text"
                                    value="#ffffff"
                                    placeholder="#ffffff"
                                    class="w-full bg-zinc-50 px-3 py-2.5 border border-zinc-200 rounded-xl outline-none text-sm font-mono"
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-4 border-t border-zinc-100 flex items-center justify-end gap-4">
                    <a href="/owners/admin" class="px-6 py-3 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-700 font-semibold text-sm transition">
                        Cancel
                    </a>
                    <button
                        type="submit"
                        class="px-8 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm transition shadow-lg shadow-blue-500/25 flex items-center gap-2"
                    >
                        <i class="ri-check-line text-lg"></i>
                        <span>Publish Product</span>
                    </button>
                </div>

            </form>

        </section>

    </div>

</main>

<script>
    function previewImageFileName(input) {
        const display = document.getElementById('fileNameDisplay');
        if (input.files && input.files[0]) {
            display.textContent = 'Selected: ' + input.files[0].name;
            display.classList.add('text-blue-600');
        }
    }
</script>

<%- include('./partials/footer') %>
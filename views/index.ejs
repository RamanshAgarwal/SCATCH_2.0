<%- include('./partials/header') %>

<main class="w-full min-h-screen pt-24 pb-16 px-4 sm:px-6 lg:px-8 flex items-center justify-center relative overflow-hidden bg-gradient-to-br from-zinc-100 via-zinc-50 to-blue-50/30">
    
    <!-- Decorative background elements -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-400/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch py-8 z-10">
        
        <!-- Registration Card -->
        <div class="bg-white/80 backdrop-blur-xl border border-zinc-200/80 rounded-3xl p-8 sm:p-10 shadow-xl shadow-zinc-200/50 flex flex-col justify-between">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-6">
                    <i class="ri-sparkles-line"></i> Join Scatch Luxury
                </div>
                
                <h2 class="text-3xl sm:text-4xl font-display font-bold text-zinc-900 tracking-tight mb-2">
                    Create Account
                </h2>
                <p class="text-zinc-500 text-sm mb-8">
                    Discover hand-crafted premium luxury bags and exclusive collections.
                </p>

                <form autocomplete="off" action="/users/register" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">Full Name</label>
                        <div class="relative">
                            <i class="ri-user-3-line absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-lg"></i>
                            <input
                                class="bg-zinc-50 focus:bg-white w-full pl-10 pr-4 py-3 border border-zinc-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 rounded-xl outline-none text-sm transition font-medium"
                                type="text"
                                placeholder="John Doe"
                                name="fullname"
                                required
                            >
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">Email Address</label>
                        <div class="relative">
                            <i class="ri-mail-line absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-lg"></i>
                            <input
                                class="bg-zinc-50 focus:bg-white w-full pl-10 pr-4 py-3 border border-zinc-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 rounded-xl outline-none text-sm transition font-medium"
                                type="email"
                                placeholder="name@example.com"
                                name="email"
                                required
                            >
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 uppercase tracking-wider mb-2">Password</label>
                        <div class="relative">
                            <i class="ri-lock-2-line absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-lg"></i>
                            <input
                                class="bg-zinc-50 focus:bg-white w-full pl-10 pr-4 py-3 border border-zinc-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 rounded-xl outline-none text-sm transition font-medium"
                                type="password"
                                placeholder="••••••••"
                                name="password"
                                required
                            >
                        </div>
                    </div>

                    <button
                        type="submit"
                        class="w-full mt-4 py-3.5 px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition shadow-lg shadow-blue-500/25 active:scale-[0.99] flex items-center justify-center gap-2"
                    >
                        <span>Create My Account</span>
                        <i class="ri-arrow-right-line text-lg"></i>
                    </button>
                </form>
            </div>

            <div class="mt-8 pt-6 border-t border-zinc-100 text-center">
                <span class="text-xs text-zinc-500">By creating an account, you agree to our Terms & Privacy Policy</span>
            </div>
        </div>

        <!-- Login Card -->
        <div class="bg-zinc-900 text-white rounded-3xl p-8 sm:p-10 shadow-2xl flex flex-col justify-between border border-zinc-800 relative overflow-hidden">
            <!-- Subtle gradient accent -->
            <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="relative z-10">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-zinc-300 text-xs font-semibold mb-6">
                    <i class="ri-shield-keyhole-line text-blue-400"></i> Existing Member
                </div>

                <h2 class="text-3xl sm:text-4xl font-display font-bold tracking-tight mb-2">
                    Welcome Back
                </h2>
                <p class="text-zinc-400 text-sm mb-8">
                    Sign in to access your saved cart, orders, and personalized bag recommendations.
                </p>

                <form autocomplete="off" action="/users/login" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Email Address</label>
                        <div class="relative">
                            <i class="ri-mail-line absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-500 text-lg"></i>
                            <input
                                class="bg-zinc-800/80 focus:bg-zinc-800 w-full pl-10 pr-4 py-3 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 rounded-xl outline-none text-sm text-white transition font-medium placeholder-zinc-500"
                                type="email"
                                placeholder="name@example.com"
                                name="email"
                                required
                            >
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Password</label>
                        <div class="relative">
                            <i class="ri-lock-2-line absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-500 text-lg"></i>
                            <input
                                class="bg-zinc-800/80 focus:bg-zinc-800 w-full pl-10 pr-4 py-3 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 rounded-xl outline-none text-sm text-white transition font-medium placeholder-zinc-500"
                                type="password"
                                placeholder="••••••••"
                                name="password"
                                required
                            >
                        </div>
                    </div>

                    <button
                        type="submit"
                        class="w-full mt-4 py-3.5 px-6 rounded-xl bg-white hover:bg-zinc-100 text-zinc-900 font-bold text-sm transition shadow-lg active:scale-[0.99] flex items-center justify-center gap-2"
                    >
                        <span>Sign In to Scatch</span>
                        <i class="ri-login-circle-line text-lg"></i>
                    </button>
                </form>
            </div>

            <div class="mt-8 pt-6 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400 relative z-10">
                <span>Are you a store admin?</span>
                <a href="/owners/login" class="text-blue-400 hover:text-blue-300 font-semibold transition flex items-center gap-1">
                    Admin Portal <i class="ri-arrow-right-s-line"></i>
                </a>
            </div>
        </div>

    </div>

</main>

<%- include('./partials/footer') %>